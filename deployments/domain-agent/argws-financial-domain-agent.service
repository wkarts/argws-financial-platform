[Unit]
Description=ARGWS Financial Platform Domain and SSL Reconciliation
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/argws-financial-domain-agent.env
ExecStart=/usr/bin/python3 /opt/argws-financial-platform/scripts/domain_agent.py
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/etc/nginx /etc/letsencrypt /var/www/letsencrypt

[Install]
WantedBy=multi-user.target
