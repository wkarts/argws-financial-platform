# ============================================================================
# ARGWS FINANCEIRO — DOCKGE + CLOUDPANEL
#
# Produção usa somente imagens publicadas no GHCR.
# O servidor NÃO compila a aplicação.
# Apenas GATEWAY_PORT é publicada no host.
#
# Primeira configuração: altere principalmente os blocos
# "IDENTIDADE", "CREDENCIAIS", "CLOUDFLARE" e "E-MAIL".
# ============================================================================

COMPOSE_PROJECT_NAME=argws-financial-platform
APP_NAME=ARGWS Financeiro
APP_ENV=production
APP_DEBUG=false
APP_VERSION=
APP_TIMEZONE=America/Bahia
LOG_LEVEL=INFO

# ============================================================================
# IDENTIDADE / DOMÍNIOS
# ============================================================================

PLATFORM_DOMAIN=financeiro.seu-dominio.com.br
CONTROL_PLANE_HOST=control.${PLATFORM_DOMAIN}
API_HOST=api.${PLATFORM_DOMAIN}
TENANT_DOMAIN_ROOT=${PLATFORM_DOMAIN}
PUBLIC_SCHEME=https

TRUSTED_HOSTS=${PLATFORM_DOMAIN},${CONTROL_PLANE_HOST},${API_HOST},.${TENANT_DOMAIN_ROOT},localhost,127.0.0.1
CORS_ORIGINS=https://${PLATFORM_DOMAIN},https://${CONTROL_PLANE_HOST}

# ÚNICA porta publicada no host. O CloudPanel aponta o Reverse Proxy para ela.
GATEWAY_BIND_IP=127.0.0.1
GATEWAY_PORT=18800

# Todos os dados persistentes ficam ao lado do compose em ./data-*.
FINANCIAL_DATA_ROOT=.

# ============================================================================
# CREDENCIAIS
#
# INTERNAL_SERVICES_PASSWORD é compartilhada apenas pelos serviços internos
# PostgreSQL/RabbitMQ/MinIO/S3 para evitar repetição no arquivo.
# Use senha URL-safe, sem espaços, ":" "/" ou "@".
# ============================================================================

APP_SECRET_KEY=CHANGE_ME_GENERATE_64_CHARS
FIELD_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

INTERNAL_SERVICES_PASSWORD=CHANGE_ME_GENERATE_INTERNAL_PASSWORD_32_CHARS
INITIAL_ADMIN_PASSWORD=CHANGE_ME_INITIAL_ADMIN_PASSWORD

DOMAIN_RECONCILIATION_TOKEN=CHANGE_ME_DOMAIN_RECONCILIATION_TOKEN
BANKING_WEBHOOK_SECRET=CHANGE_ME_BANKING_WEBHOOK_SECRET

# ============================================================================
# POSTGRESQL
# ============================================================================

POSTGRES_DB=financial_platform
POSTGRES_USER=financial_admin
POSTGRES_ADMIN_USER=financial_admin
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=20

TENANT_DB_PREFIX=fin_tenant
TENANT_DB_USER_PREFIX=fin_t

# ============================================================================
# REDIS / FILAS
# ============================================================================

REDIS_CACHE_TTL_SECONDS=300
RABBITMQ_USER=financial

CELERY_TASK_ALWAYS_EAGER=false
CELERY_DEFAULT_CONCURRENCY=2
CELERY_BILLING_CONCURRENCY=2
CELERY_NOTIFICATION_CONCURRENCY=2
PROVISIONING_ASYNC=true

# ============================================================================
# MINIO / S3
# ============================================================================

MINIO_ROOT_USER=financial
S3_REGION=sa-east-1
S3_USE_SSL=false
S3_BUCKET_PREFIX=financial-tenant
S3_PUBLIC_ENDPOINT_URL=

# ============================================================================
# ADMINISTRAÇÃO INICIAL
# ============================================================================

PLATFORM_ADMIN_NAME=Administrador da Plataforma
PLATFORM_ADMIN_EMAIL=admin@seu-dominio.com.br

BOOTSTRAP_DEMO_TENANT=false
DEMO_TENANT_NAME=Empresa Demonstração
DEMO_TENANT_SLUG=demo
DEMO_TENANT_ADMIN_NAME=Administrador Demo
DEMO_TENANT_ADMIN_EMAIL=admin.demo@seu-dominio.com.br
DEMO_TENANT_ADMIN_PASSWORD=${INITIAL_ADMIN_PASSWORD}

# ============================================================================
# CLOUDFLARE — WILDCARD DNS AUTOMÁTICO
#
# A aplicação lê pela API Cloudflare o registro atual de PLATFORM_DOMAIN,
# deriva a origem real e cria automaticamente, em DNS-only:
#
#   proxy.PLATFORM_DOMAIN     -> mesma origem do domínio principal
#   *.TENANT_DOMAIN_ROOT      -> proxy.PLATFORM_DOMAIN
#
# Assim não é necessário repetir o IP público neste arquivo e o certificado
# wildcard é terminado no CloudPanel, não na borda da Cloudflare.
# ============================================================================

CLOUDFLARE_ENABLED=true
CLOUDFLARE_API_TOKEN=__CONFIGURE_CLOUDFLARE_TOKEN__
CLOUDFLARE_ZONE_ID=__CONFIGURE_CLOUDFLARE_ZONE_ID__
CLOUDFLARE_ZONE_NAME=seu-dominio.com.br

CLOUDFLARE_PROXIED=false
CLOUDFLARE_PROVISIONING_MODE=wildcard
CLOUDFLARE_TENANT_RECORD_TARGET=proxy.${PLATFORM_DOMAIN}

# ============================================================================
# ACME + CLOUDPANEL
#
# ÚNICA etapa manual no CloudPanel:
# Reverse Proxy PLATFORM_DOMAIN -> http://127.0.0.1:GATEWAY_PORT
#
# Depois disso a stack:
# - garante o DNS wildcard;
# - emite PLATFORM_DOMAIN + *.TENANT_DOMAIN_ROOT por DNS-01;
# - adiciona o wildcard ao server_name do VHost;
# - instala/renova o certificado via clpctl;
# - valida nginx -t antes de manter qualquer alteração.
# ============================================================================

ACME_DOMAIN=${PLATFORM_DOMAIN}
ACME_EMAIL=admin@seu-dominio.com.br
ACME_STAGING=false
ACME_DNS_SLEEP=20
ACME_CHECK_INTERVAL_SECONDS=43200

CLOUDPANEL_SITE_DOMAIN=${PLATFORM_DOMAIN}
CLOUDPANEL_WILDCARD_DOMAIN=*.${TENANT_DOMAIN_ROOT}
CLOUDPANEL_SYNC_INTERVAL_SECONDS=60

# ============================================================================
# SMTP — OPCIONAL
# ============================================================================

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
SMTP_FROM_EMAIL=no-reply@seu-dominio.com.br
SMTP_FROM_NAME=ARGWS Financeiro
SMTP_TIMEOUT_SECONDS=30

# ============================================================================
# WHATSAPP / EVOLUTION — OPCIONAL
# ============================================================================

EVOLUTION_ENABLED=false
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=financial-platform
EVOLUTION_SEND_TEXT_PATH=/message/sendText/{instance}
EVOLUTION_SEND_MEDIA_PATH=/message/sendMedia/{instance}
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_TIMEOUT_SECONDS=30
WEBHOOK_MAX_AGE_SECONDS=300

# ============================================================================
# BACKUP
# ============================================================================

BACKUP_ENABLED=true
BACKUP_DIR=/data/backups
BACKUP_CRON=0 2 * * *
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
BACKUP_COMPRESS_LEVEL=9

BACKUP_UPLOAD_S3=true
BACKUP_S3_BUCKET=financial-backups

BACKUP_ENCRYPTION_RECIPIENT=
BACKUP_ENCRYPTION_IDENTITY=/run/secrets/backup_age_identity
BACKUP_RCLONE_CONFIG=/run/secrets/rclone_config

BACKUP_GOOGLE_DRIVE_ENABLED=false
BACKUP_GOOGLE_DRIVE_REMOTE=gdrive:argws-financial-platform
BACKUP_DROPBOX_ENABLED=false
BACKUP_DROPBOX_REMOTE=dropbox:argws-financial-platform

MAINTENANCE_FILE=/data/runtime/maintenance.flag

# ============================================================================
# SEGURANÇA
# ============================================================================

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_DEFAULT=120/minute
ALLOW_DEV_TENANT_HEADER=false

# ============================================================================
# FRONTEND PUBLICADO
# ============================================================================

VITE_APP_NAME=ARGWS Financeiro
VITE_CONTROL_PLANE_HOST=${CONTROL_PLANE_HOST}
VITE_API_BASE_URL=/api
VITE_APP_VERSION=
