# ============================================================================
# ARGWS FINANCIAL PLATFORM — DOCKGE / PRODUÇÃO POR IMAGENS
#
# O Dockge usa exclusivamente imagens publicadas no GHCR.
# Não requer backend/, frontend/, Dockerfiles nem código-fonte na pasta da stack.
# VERSION é embutido nas imagens durante o release; não fixe versão aqui.
# Com FINANCIAL_DATA_ROOT=. todos os dados persistentes ficam em ./data-*.
# ============================================================================

COMPOSE_PROJECT_NAME=argws-financial-platform
APP_NAME=ARGWS Financial Platform
APP_ENV=production
APP_DEBUG=false
APP_VERSION=
APP_TIMEZONE=America/Bahia
APP_SECRET_KEY=CHANGE_ME_GENERATE_64_CHARS
FIELD_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
LOG_LEVEL=INFO

# Imagens publicadas e persistência local da stack
APP_PULL_POLICY=always
FINANCIAL_DATA_ROOT=.
BACKEND_IMAGE=ghcr.io/wkarts/argws-financial-api:latest
FRONTEND_IMAGE=ghcr.io/wkarts/argws-financial-web:latest
GATEWAY_IMAGE=ghcr.io/wkarts/argws-financial-gateway:latest
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:8-alpine
RABBITMQ_IMAGE=rabbitmq:4-management-alpine
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-08-13T08-35-41Z
ACME_IMAGE=ghcr.io/wkarts/argws-financial-acme:latest
CLOUDPANEL_AGENT_IMAGE=ghcr.io/wkarts/argws-financial-cloudpanel-agent:latest
RCLONE_CONFIG_PATH=./secrets/rclone.conf
BACKUP_AGE_IDENTITY_PATH=./secrets/backup-age-identity.txt

# Domínios
PLATFORM_DOMAIN=financeiro.seu-dominio.com.br
CONTROL_PLANE_HOST=control.financeiro.seu-dominio.com.br
API_HOST=api.financeiro.seu-dominio.com.br
TENANT_DOMAIN_ROOT=financeiro.seu-dominio.com.br
PUBLIC_SCHEME=https
TRUSTED_HOSTS=financeiro.seu-dominio.com.br,control.financeiro.seu-dominio.com.br,api.financeiro.seu-dominio.com.br,.financeiro.seu-dominio.com.br,localhost,127.0.0.1
CORS_ORIGINS=https://financeiro.seu-dominio.com.br,https://control.financeiro.seu-dominio.com.br
GATEWAY_BIND_IP=127.0.0.1
GATEWAY_PORT=8800

# PostgreSQL — POSTGRES_ADMIN_USER=POSTGRES_USER exige a mesma senha.
POSTGRES_HOST=financial-postgres
POSTGRES_PORT=5432
POSTGRES_DB=financial_platform
POSTGRES_USER=financial_admin
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_ADMIN_USER=financial_admin
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=20
API_WORKERS=2
TENANT_DB_PREFIX=fin_tenant
TENANT_DB_USER_PREFIX=fin_t

# Redis
REDIS_URL=redis://financial-redis:6379/0
REDIS_CACHE_TTL_SECONDS=300

# RabbitMQ / Celery
RABBITMQ_USER=financial
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_URL=amqp://financial:CHANGE_ME_RABBITMQ_PASSWORD@financial-rabbitmq:5672/financial
RABBITMQ_MANAGEMENT_BIND_IP=127.0.0.1
RABBITMQ_MANAGEMENT_PORT=15672
CELERY_BROKER_URL=amqp://financial:CHANGE_ME_RABBITMQ_PASSWORD@financial-rabbitmq:5672/financial
CELERY_RESULT_BACKEND=redis://financial-redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false
CELERY_DEFAULT_CONCURRENCY=2
CELERY_BILLING_CONCURRENCY=2
CELERY_NOTIFICATION_CONCURRENCY=2
PROVISIONING_ASYNC=true

# MinIO / S3 — enquanto usar o usuário root do MinIO, as duas senhas devem coincidir.
S3_ENDPOINT_URL=http://financial-minio:9000
S3_PUBLIC_ENDPOINT_URL=
S3_REGION=sa-east-1
S3_ACCESS_KEY=financial
S3_SECRET_KEY=CHANGE_ME_MINIO_SECRET
S3_USE_SSL=false
S3_BUCKET_PREFIX=financial-tenant
MINIO_ROOT_USER=financial
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_SECRET
MINIO_CONSOLE_BIND_IP=127.0.0.1
MINIO_CONSOLE_PORT=9001

# Bootstrap do Control Plane
PLATFORM_ADMIN_NAME=Administrador da Plataforma
PLATFORM_ADMIN_EMAIL=admin@seu-dominio.com.br
PLATFORM_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
BOOTSTRAP_DEMO_TENANT=false
DEMO_TENANT_NAME=Empresa Demonstração
DEMO_TENANT_SLUG=demo
DEMO_TENANT_ADMIN_NAME=Administrador Demo
DEMO_TENANT_ADMIN_EMAIL=admin.demo@example.com
DEMO_TENANT_ADMIN_PASSWORD=CHANGE_ME_DEMO_PASSWORD

# Cloudflare / provisionamento de tenants
CLOUDFLARE_ENABLED=false
CLOUDFLARE_API_TOKEN=__CONFIGURE_CLOUDFLARE_TOKEN__
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ZONE_NAME=seu-dominio.com.br
CLOUDFLARE_PROXIED=true
CLOUDFLARE_TENANT_RECORD_TARGET=financeiro.seu-dominio.com.br
CLOUDFLARE_PROVISIONING_MODE=wildcard
DOMAIN_RECONCILIATION_TOKEN=CHANGE_ME_DOMAIN_AGENT_TOKEN

# CloudPanel é externo à stack Dockge. O reverse proxy deve apontar para 127.0.0.1:GATEWAY_PORT.
ACME_ENABLED=false
ACME_DOMAIN=financeiro.seu-dominio.com.br
ACME_EMAIL=infra@seu-dominio.com.br
ACME_STAGING=false
ACME_DNS_SLEEP=20
ACME_CHECK_INTERVAL_SECONDS=43200
CLOUDPANEL_SYNC_INTERVAL_SECONDS=60
CLOUDPANEL_AGENT_ENABLED=false
CLOUDPANEL_SITE_USER=financial
CLOUDPANEL_SITE_USER_PASSWORD=CHANGE_ME_CLOUDPANEL_SITE_PASSWORD

# SMTP
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
SMTP_FROM_EMAIL=financeiro@seu-dominio.com.br
SMTP_FROM_NAME=ARGWS Financial Platform
SMTP_TIMEOUT_SECONDS=30

# Evolution API
EVOLUTION_ENABLED=false
EVOLUTION_BASE_URL=http://evolution-api:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=financial-platform
EVOLUTION_SEND_TEXT_PATH=/message/sendText/{instance}
EVOLUTION_SEND_MEDIA_PATH=/message/sendMedia/{instance}
EVOLUTION_WEBHOOK_SECRET=CHANGE_ME_EVOLUTION_WEBHOOK_SECRET
EVOLUTION_TIMEOUT_SECONDS=30
BANKING_WEBHOOK_SECRET=CHANGE_ME_BANKING_WEBHOOK_SECRET
WEBHOOK_MAX_AGE_SECONDS=300

# Backup
BACKUP_ENABLED=true
BACKUP_DIR=/data/backups
BACKUP_CRON=0 2 * * *
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
BACKUP_COMPRESS_LEVEL=9
BACKUP_ENCRYPTION_RECIPIENT=
BACKUP_ENCRYPTION_IDENTITY=/run/secrets/backup_age_identity
MAINTENANCE_FILE=/data/runtime/maintenance.flag
BACKUP_UPLOAD_S3=true
BACKUP_S3_BUCKET=financial-backups
BACKUP_RCLONE_CONFIG=/run/secrets/rclone_config
BACKUP_GOOGLE_DRIVE_ENABLED=false
BACKUP_GOOGLE_DRIVE_REMOTE=gdrive:argws-financial-platform
BACKUP_DROPBOX_ENABLED=false
BACKUP_DROPBOX_REMOTE=dropbox:argws-financial-platform

# Segurança
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_DEFAULT=120/minute
ALLOW_DEV_TENANT_HEADER=false

# Observabilidade
MONITORING_ENABLED=false
PROMETHEUS_ENABLED=true
PROMETHEUS_BIND_IP=127.0.0.1
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
GRAFANA_BIND_IP=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
GRAFANA_ROOT_URL=https://grafana.financeiro.seu-dominio.com.br

# Frontend PWA — já compilado na imagem publicada.
VITE_APP_NAME=ARGWS Financial Platform
VITE_CONTROL_PLANE_HOST=control.financeiro.seu-dominio.com.br
VITE_API_BASE_URL=/api
VITE_APP_VERSION=
